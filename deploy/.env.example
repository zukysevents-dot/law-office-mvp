# =============================================================================
# Production .env template for the VPS (Docker Compose).
# Copy to the repo root as `.env` ON THE SERVER and fill in. NEVER commit it.
#   cp deploy/.env.example .env
# Compose injects these into the app/caddy/cron containers (env_file: .env).
# =============================================================================

# ---- Reverse proxy / TLS (Caddy) --------------------------------------------
# Real hostname -> automatic HTTPS. Use ":80" for IP-only / pre-DNS testing.
APP_DOMAIN=app.example.cz
ACME_EMAIL=it@example.cz

# Public base URL the app builds links with (must match APP_DOMAIN scheme/host).
APP_BASE_URL=https://app.example.cz

# ---- Database ---------------------------------------------------------------
# DECISION PENDING (probrat se Standou): managed (Supabase) vs. local-db profile.
#  - Supabase:  paste the pooled + direct URLs from the Supabase dashboard.
#  - local-db:  DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@postgres:5432/law_office_mvp
#               DIRECT_URL same as DATABASE_URL, and set POSTGRES_PASSWORD below.
DATABASE_URL=
DIRECT_URL=

# Only needed when running the `local-db` compose profile:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=law_office_mvp

# ---- Secrets (generate with: openssl rand -base64 32) -----------------------
SESSION_SECRET=
PORTAL_SESSION_SECRET=
DATA_ENCRYPTION_KEY=
# Bearer token the cron sidecar sends; routes 503 if unset.
CRON_SECRET=
# Legacy alias still accepted by the notification route.
NOTIFICATION_RUN_SECRET=

# ---- Email / notifications --------------------------------------------------
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false

# ---- Integrations (fill when enabling the feature) --------------------------
# Registry monitoring (ARES) — used by the /registry cron.
ARES_BASE_URL=https://ares.gov.cz/ekonomicke-subjekty-v-be/rest
ARES_LOOKUP_ENABLED=true

# SharePoint / Microsoft Graph (document storage)
SHAREPOINT_SITE_URL=
SHAREPOINT_LIBRARY=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# AML / sanctions
EU_SANCTIONS_LIST_URL=
SANCTIONS_REFRESH_SECRET=

# ISDS (datové schránky)
ISDS_ENABLED=false

# Password for the demo/test seed scripts (db:seed-*). NOT used by db:bootstrap
# — the first real admin is created with BOOTSTRAP_* vars passed inline
# (see deploy/DEPLOY.md, "Založení první kanceláře a admina").
SEED_USER_PASSWORD=
