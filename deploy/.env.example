# =============================================================================
# Production .env template for the VPS (Docker Compose + nginx on the host).
# deploy/setup-vps.sh copies this to the repo root as `.env` ON THE SERVER and
# fills every EMPTY key it knows (secrets, DB URLs, APP_BASE_URL). Values you
# fill in yourself are never overwritten. NEVER commit the resulting .env.
# Compose injects these into the app/cron containers (env_file: .env).
# =============================================================================

# ---- Compose (read by `docker compose` itself) -------------------------------
# Lets a plain `docker compose <cmd>` use the prod file + local Postgres.
# Leave COMPOSE_PROFILES empty when the DB is managed (Supabase).
COMPOSE_FILE=compose.prod.yaml
COMPOSE_PROFILES=local-db

# ---- Public URL ------------------------------------------------------------
# Full public URL incl. https:// — links in e-mails/notifications use it.
# setup-vps.sh sets it to https://$DOMAIN when empty.
APP_BASE_URL=

# Internal office app: public self-registration off (accounts via admin).
REGISTRATION_ENABLED=false
# Hosts that serve ONLY the marketing landing page (leave empty here).
LANDING_ONLY_HOSTS=

# ---- Database ---------------------------------------------------------------
# DECISION PENDING (probrat se Standou): managed (Supabase) vs. local-db profile.
#  - Supabase:  paste the pooled + direct URLs from the Supabase dashboard.
#  - local-db:  DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@postgres:5432/law_office_mvp
#               DIRECT_URL same as DATABASE_URL, and set POSTGRES_PASSWORD below.
DATABASE_URL=
DIRECT_URL=

# Only needed when running the `local-db` compose profile:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=law_office_mvp

# ---- Secrets (generate with: openssl rand -base64 32) -----------------------
SESSION_SECRET=
PORTAL_SESSION_SECRET=
DATA_ENCRYPTION_KEY=
# Bearer token the cron sidecar sends; routes 503 if unset.
CRON_SECRET=
# Legacy alias still accepted by the notification route.
NOTIFICATION_RUN_SECRET=

# ---- Email / notifications + required public registration verification ------
# Set true and configure SMTP in production if /register is exposed. Without a
# working transporter registration returns a generic response but creates no User.
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false

# ---- Integrations (fill when enabling the feature) --------------------------
# Registry monitoring (ARES) — used by the /registry cron.
ARES_BASE_URL=https://ares.gov.cz/ekonomicke-subjekty-v-be/rest
ARES_LOOKUP_ENABLED=true

# SharePoint / Microsoft Graph (document storage)
# Fallback only — each office connects its own SharePoint in-app under
# Nastavení → SharePoint. A saved office config wins over these values.
SHAREPOINT_SITE_URL=
SHAREPOINT_LIBRARY=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# AML / sanctions
EU_SANCTIONS_LIST_URL=
SANCTIONS_REFRESH_SECRET=

# ISDS (datové schránky)
ISDS_ENABLED=false

# Password for the demo/test seed scripts (db:seed-*). NOT used by db:bootstrap
# — the first real admin is created with BOOTSTRAP_* vars passed inline
# (see deploy/DEPLOY.md, "Založení první kanceláře a admina").
SEED_USER_PASSWORD=
